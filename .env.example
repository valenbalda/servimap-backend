# Copiá este archivo como .env y completá los valores reales.
# El .env NUNCA se sube a GitHub.

PORT=3000
NODE_ENV=development

# Connection string de PostgreSQL (Neon, Supabase o local)
DATABASE_URL="postgresql://usuario:password@host:5432/servimap?schema=public"

# Secreto para firmar los JWT (mínimo 32 caracteres, aleatorio)
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio-de-32-o-mas-caracteres"
JWT_EXPIRES_IN=1d

# URL del frontend permitida por CORS (separar con coma si son varias)
CORS_ORIGIN=http://localhost:5173
