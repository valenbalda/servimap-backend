{
  "name": "servimap-backend",
  "version": "1.0.0",
  "description": "API REST de **ServiMap**, una plataforma web que combina un mapa interactivo con un directorio de prestadores de servicios del hogar (plomería, electricidad, pintura, gas y carpintería).",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "jest",
    "test:unit": "jest --testPathIgnorePatterns /node_modules/ /tests/integration/",
    "test:integration": "jest tests/integration --runInBand",
    "test:qase": "jest --runInBand",
    "docs:qa": "node scripts/generarDocsQa.js",
    "qase:ids": "node scripts/sincronizarQaseIds.js",
    "postinstall": "prisma generate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/valenbalda/servimap-backend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/valenbalda/servimap-backend/issues"
  },
  "homepage": "https://github.com/valenbalda/servimap-backend#readme",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "jest-qase-reporter": "^2.6.0",
    "nodemon": "^3.1.14",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1"
  }
}
